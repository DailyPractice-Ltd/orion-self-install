    { "name": "a colon after the start: Windows writes a hidden stream, not a file", "files": [{ "path": "SKILL.md", "content": "#" }, { "path": "refs/x.md:notes.md", "content": "x" }], "problem": "^refs/x\\.md:notes\\.md: bad character$" },
