    { "name": "the entry file alone", "files": [{ "path": "SKILL.md", "content": "# s" }], "problem": null },
    { "name": "every text extension, folders deep", "files": [{ "path": "SKILL.md", "content": "#" }, { "path": "references/boundary.md", "content": "x" }, { "path": "templates/confirm.json", "content": "{}" }, { "path": "a/b/c.yaml", "content": "x" }, { "path": "agents/openai.yml", "content": "x" }, { "path": "notes.txt", "content": "x" }, { "path": "data.csv", "content": "x" }], "problem": null },
    { "name": "an extension in capitals is still text", "files": [{ "path": "SKILL.md", "content": "#" }, { "path": "README.MD", "content": "x" }], "problem": null },
    { "name": "spaces and ordinary punctuation inside a name", "files": [{ "path": "SKILL.md", "content": "#" }, { "path": "call list (v2)/first call - notes & asks.md", "content": "x" }, { "path": "v1.2/it's #1.md", "content": "x" }], "problem": null },
    { "name": "accents and other scripts, each name once", "files": [{ "path": "SKILL.md", "content": "#" }, { "path": "r\u00e9f\u00e9rences/caf\u00e9.md", "content": "x" }, { "path": "\u65e5\u672c\u8a9e.md", "content": "x" }], "problem": null },
    { "name": "different accents are different files", "files": [{ "path": "SKILL.md", "content": "#" }, { "path": "a/\u00e9.md", "content": "1" }, { "path": "a/\u00e8.md", "content": "2" }, { "path": "a/e.md", "content": "3" }], "problem": null },
    { "name": "names that share a start are not a file and its folder", "files": [{ "path": "SKILL.md", "content": "#" }, { "path": "x.md", "content": "1" }, { "path": "x.md.txt", "content": "2" }, { "path": "x.md-old/y.md", "content": "3" }, { "path": "references.md", "content": "4" }, { "path": "references/a.md", "content": "5" }], "problem": null },
    { "name": "one folder spelled two ways, holding different files", "files": [{ "path": "SKILL.md", "content": "#" }, { "path": "Refs/a.md", "content": "1" }, { "path": "refs/b.md", "content": "2" }], "problem": null },

    { "name": "not a list", "files": "nope", "problem": "^no files$" },
    { "name": "nothing at all", "files": null, "problem": "^no files$" },
    { "name": "an empty list", "files": [], "problem": "^no files$" },
