{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release deployment plan",
  "type": "object",
  "required": ["template_version", "deployment"],
  "properties": {
    "template_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "deployment": {
      "type": "object",
      "required": ["tools", "common_sources", "entries"],
      "properties": {
        "tools": { "const": ["claude-code", "codex"] },
        "common_sources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
        "retired": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["source", "destinations", "fingerprint_key"],
      "properties": {
        "source": { "type": "string" },
        "destinations": { "type": "object", "required": ["claude-code", "codex"], "properties": { "claude-code": { "type": "string" }, "codex": { "type": "string" } } },
        "fingerprint_key": { "type": "string" },
        "ownership": { "enum": ["release", "client-template"] }
      }
    }
  }
}
