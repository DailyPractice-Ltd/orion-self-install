{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployed harness selected tool",
  "type": "object",
  "required": ["selected_tool", "template_version"],
  "properties": {
    "selected_tool": { "enum": ["claude-code", "codex"] },
    "template_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
