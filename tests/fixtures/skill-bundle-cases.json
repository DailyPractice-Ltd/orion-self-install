{
  "_what": "The skill bundle rules, written as cases that both ends of the radio run. The same file lives in dailypractice-mono (specs/004-skills-library/contracts/skill-bundle-cases.json, run by apps/enablement/tests/unit/library-bundle.test.ts) and in orion-self-install (tests/fixtures/skill-bundle-cases.json, run by tests/multi-file-skills.test.mjs). Change a rule on one end and these fail there. Fix them here, then copy this file to the other repo unchanged, so that end fails too until its rule matches.",
  "_shape": "problem is null when the case is allowed, otherwise text the refusal must contain. A bundle is a list of paths; every file in it holds one character.",
  "paths": [
    { "path": "SKILL.md", "problem": null },
    { "path": "references/boundary.md", "problem": null },
    { "path": "templates/confirm.json", "problem": null },
    { "path": "a/b/c.yaml", "problem": null },
    { "path": "notes/call list.md", "problem": null },
    { "path": "", "problem": "empty or too long" },
    { "path": "check.mjs", "problem": "not a text file" },
    { "path": "a.png", "problem": "not a text file" },
    { "path": "noext", "problem": "not a text file" },
    { "path": "../x.md", "problem": "dot segment" },
    { "path": "a/../b.md", "problem": "dot segment" },
    { "path": "a//b.md", "problem": "dot segment" },
    { "path": "/etc/x.md", "problem": "absolute path" },
    { "path": "C:/x.md", "problem": "absolute path" },
    { "path": "C:\\x.md", "problem": "bad character" },
    { "path": ".hidden.md", "problem": "hidden file" },
    { "path": "a/.git/x.md", "problem": "hidden file" },
    { "path": "refs/x.md:notes.md", "problem": "bad character" },
    { "path": "refs/a?b.md", "problem": "bad character" },
    { "path": "refs/a*b.md", "problem": "bad character" },
    { "path": "refs/a<b.md", "problem": "bad character" },
    { "path": "refs/a>b.md", "problem": "bad character" },
    { "path": "refs/a|b.md", "problem": "bad character" },
    { "path": "refs/a\"b.md", "problem": "bad character" },
    { "path": "refs /x.md", "problem": "trailing space or dot" },
    { "path": "refs./x.md", "problem": "trailing space or dot" },
    { "path": "refs/x.md ", "problem": "trailing space or dot" }
  ],
  "bundles": [
    { "paths": ["SKILL.md"], "problem": null },
    { "paths": ["SKILL.md", "references/x.md"], "problem": null },
    { "paths": ["SKILL.md", "a/b.md", "a/c.md"], "problem": null },
    { "paths": [], "problem": "no files" },
    { "paths": ["references/x.md"], "problem": "no SKILL.md" },
    { "paths": ["skill.md"], "problem": "no SKILL.md" },
    { "paths": ["Skill.md", "references/x.md"], "problem": "no SKILL.md" },
    { "paths": ["SKILL.md", "SKILL.md"], "problem": "listed twice" },
    { "paths": ["SKILL.md", "skill.md"], "problem": "listed twice" },
    { "paths": ["SKILL.md", "a/B.md", "a/b.md"], "problem": "listed twice" },
    { "paths": ["SKILL.md", "a/\u00e9.md", "a/e\u0301.md"], "problem": "listed twice" },
    { "paths": ["SKILL.md", "x.md", "x.md/y.md"], "problem": "both a file and a folder" },
    { "paths": ["SKILL.md", "x.md/y.md", "x.md"], "problem": "both a file and a folder" },
    { "paths": ["SKILL.md", "X.md", "x.md/y.md"], "problem": "both a file and a folder" },
    { "paths": ["SKILL.md", "check.mjs"], "problem": "not a text file" }
  ]
