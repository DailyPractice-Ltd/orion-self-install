{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orion-self-install/contracts/status-signal.schema.json",
  "title": "Authenticated install checkpoint signal",
  "description": "Current labels-only authenticated bridge envelope, replacing the retired unauthenticated 001 webhook. Original identity persists through durable replay; see 002 bridge-radio and 007 status-and-guard contracts.",
  "type": "object",
  "required": [
    "signal_type",
    "occurred_at",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "harness_id": {
      "type": "string",
      "format": "uuid"
    },
    "signal_type": {
      "const": "install_checkpoint"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "ops_stage",
        "harness_status",
        "template_version"
      ],
      "additionalProperties": false,
      "properties": {
        "ops_stage": {
          "enum": [
            "booked",
            "day1_encode",
            "day2_wire_and_run",
            "validated",
            "seven_day_checkin",
            "formalised"
          ]
        },
        "harness_status": {
          "enum": [
            "draft",
            "configured",
            "connected",
            "validated",
            "installed/running",
            "running"
          ]
        },
        "template_version": {
          "type": "string"
        }
      }
    }
  }
}
